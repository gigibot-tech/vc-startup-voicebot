# Copy to .env (never commit .env). Everything here is optional unless marked REQUIRED.

# --- LLM (REQUIRED: a live model; there is no fallback) ----------------------------------
LLM_PROVIDER=ollama               # ollama | openai | openai_compatible | vllm
LLM_MODEL=granite4.2:8b
LLM_BASE_URL=http://127.0.0.1:11434
# LLM_API_KEY=                    # only for openai-compatible servers
# LLM_TIMEOUT=120                 # seconds per LLM call

# --- Speech out (TTS) and speech in (STT) ------------------------------------------------
ELEVENLABS_API_KEY=               # without it: no spoken replies
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=
DEEPGRAM_API_KEY=                 # optional second STT; otherwise ElevenLabs STT / browser Web Speech
# STT_PROVIDER=elevenlabs         # elevenlabs | deepgram | browser

# --- Server ------------------------------------------------------------------------------
# UI_HOST=127.0.0.1
# UI_PORT=8140
# DATA_DIR=./data/sessions        # where conversations are stored

# --- PDF upload (branch pdf-upload only) -------------------------------------------------
# PDF_PARSER=auto                 # auto | pypdf | docling   (docling: uv sync --extra docs)
