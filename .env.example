# Copy to .env (never commit .env). Everything here is optional unless marked REQUIRED.

# --- LLM (REQUIRED: a live model; there is no fallback) ----------------------------------
LLM_PROVIDER=ollama               # ollama | openai | openai_compatible | vllm
LLM_MODEL=granite4.2:8b
LLM_BASE_URL=http://127.0.0.1:11434
# LLM_API_KEY=                    # only for openai-compatible servers
# LLM_TIMEOUT=120                 # seconds per LLM call
#
# EU cloud alternative (Scaleway Generative APIs, France; 1M tokens free, then per token).
# Uncomment these four lines and comment out the Ollama block above. Key: console.scaleway.com
# -> IAM -> API keys. Prefer a non-reasoning model: reasoning models (gpt-oss-120b) spend
# max_tokens on hidden thinking and can return empty replies.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.scaleway.ai/v1
# LLM_MODEL=mistral-small-3.2-24b-instruct-2506
# LLM_API_KEY=<your Scaleway secret key>
# Other EU hosts work the same way: IONOS (Germany) https://openai.inference.de-txl.ionos.com/v1,
# STACKIT (Germany), OVHcloud AI Endpoints (France) — only these three variables change.

# --- Speech out (TTS) and speech in (STT) ------------------------------------------------
ELEVENLABS_API_KEY=               # without it: no spoken replies
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=
DEEPGRAM_API_KEY=                 # optional second STT; otherwise ElevenLabs STT / browser Web Speech
# STT_PROVIDER=elevenlabs         # elevenlabs | deepgram | browser

# --- Voice mode: classic (push-to-talk, default) or livekit (hands-free call) ---------------
# livekit needs a LiveKit server + the voice worker running next to the app:
#   uv run --extra livekit-voice startup-voice-agent dev
# Without all three LIVEKIT_* values the option stays disabled in Settings > Voice mode.
# VOICE_MODE=classic                # default for new browsers; the user can switch in Settings
# LIVEKIT_URL=wss://<project>.livekit.cloud     # or ws://127.0.0.1:7880 for `livekit-server --dev`
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_STT=deepgram              # deepgram | elevenlabs | local (default: whichever key exists)
# local Whisper = any OpenAI-compatible server on this machine (e.g. speaches / faster-whisper-server);
# audio stays local, no live words while you talk. TTS still needs ELEVENLABS_API_KEY.
# LIVEKIT_STT_BASE_URL=http://127.0.0.1:8000/v1
# LIVEKIT_STT_MODEL=Systran/faster-whisper-small
# LIVEKIT_STT_API_KEY=              # usually not needed
# LIVEKIT_ENDPOINT_MIN=0.9          # seconds of silence before your turn ends (founders pause)
# LIVEKIT_TURN_DETECTOR=multilingual  # optional semantic turn detection (extra model download)

# --- Server ------------------------------------------------------------------------------
# UI_HOST=127.0.0.1
# UI_PORT=8140
# DATA_DIR=./data/sessions        # where conversations are stored

# --- PDF upload (branch pdf-upload only) -------------------------------------------------
# PDF_PARSER=auto                 # auto | pypdf | docling   (docling: uv sync --extra docs)
